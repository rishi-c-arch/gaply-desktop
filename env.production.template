# GAPLY Frontend - Production Environment Variables
# Copy this file to .env.production and update with your Render backend URL

# Backend API Configuration
REACT_APP_API_BASE_URL=https://your-render-backend-url.onrender.com

# Razorpay Configuration (Production Keys)
REACT_APP_RAZORPAY_KEY_ID=rzp_live_REMOVED

# Environment
REACT_APP_ENVIRONMENT=production

# Domain Configuration
REACT_APP_DOMAIN=gaply.in

# Optional: Analytics and Monitoring
REACT_APP_GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID

# Optional: Error Tracking
REACT_APP_SENTRY_DSN=YOUR_SENTRY_DSN
