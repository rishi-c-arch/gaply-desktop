{
  "version": 2,
  "buildCommand": "npm run build:prod",
  "outputDirectory": "build",
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://www.gaply.in/:path*",
      "permanent": true,
      "has": [{"type": "host", "value": "gaply.in"}]
    }
  ],
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload"}, {"key": "X-Frame-Options", "value": "DENY"}, {"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "no-referrer-when-downgrade"}, {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]},
    {"source": "/static/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]}
  ],
  "rewrites": [
    {"source": "/final-orchestrator", "destination": "/final-orchestrator/index.html"},
    {"source": "/final-orchestrator/(.*)", "destination": "/final-orchestrator/index.html"},
    {"source": "/(.*)", "destination": "/index.html"}
  ],
  "env": {
    "REACT_APP_API_BASE_URL": "https://gaply-backend-gaply.up.railway.app",
    "REACT_APP_API_URL": "https://gaply-backend-gaply.up.railway.app",
    "REACT_APP_ENVIRONMENT": "production"
  }
}
