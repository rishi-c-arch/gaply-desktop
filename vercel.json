{
  "version": 2,
  "installCommand": "rm -rf node_modules build .cache && npm ci --omit=dev --no-audit --no-fund",
  "buildCommand": "node scripts/cra-build.js",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "DISABLE_ESLINT_PLUGIN": "true",
    "GENERATE_SOURCEMAP": "false",
    "SKIP_PREFLIGHT_CHECK": "true"
  }
}
