{
  "version": 2,
  "buildCommand": "npm run build:prod",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "REACT_APP_API_URL": "https://gaply-backend-production.up.railway.app",
    "REACT_APP_ENVIRONMENT": "production"
  }
}
