# Gaply — environment template. PLACEHOLDERS ONLY. Never put real secrets here.
# Copy to `.env.local` (git-ignored) and fill in real values, or set them in
# your hosting platform (Vercel/Netlify) / CI. Only `*.example` files are tracked.
#
# CRA reads REACT_APP_* at build time. Vite-style VITE_* vars are IGNORED by CRA
# (a stray VITE_API_BASE_URL was the reason an earlier .env silently did nothing).

# ── Backend API (public base URL, not a secret) ────────────────────────────
REACT_APP_API_BASE_URL=https://your-backend.example.com
REACT_APP_API_URL=https://your-backend.example.com
REACT_APP_ENVIRONMENT=development

# ── Supabase — auth + metadata ONLY (manuscripts never touch Supabase) ──────
# Leave BOTH unset to run in full OFFLINE MODE (all free-offline features work).
# The anon key is a public client key by design; the service_role key must NEVER
# appear in the frontend or this repo.
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key

# ── Razorpay ────────────────────────────────────────────────────────────────
# ONLY the public Key ID may live client-side. The Key SECRET is a server-only
# credential: it must NEVER be in the frontend bundle, this repo, netlify.toml,
# or any REACT_APP_* var. Order creation + signature verification happen on the
# backend, which holds the secret in its own server env.
REACT_APP_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# REACT_APP_RAZORPAY_KEY_SECRET=  ← DO NOT SET. server-only. never client-side.

# ── Optional ────────────────────────────────────────────────────────────────
# REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX
