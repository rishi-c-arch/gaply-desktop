// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AiCheckReport — observable-output equivalence pin > English fixture renders the locked DOM 1`] = `"<div class="gds-report" data-testid="aicheck-report" style="display: grid; gap: 12px;"><section data-testid="ai-caution" class="aic-callout"><span class="gds-badge gds-badge--flagged ">signal, not proof</span><p class="gds-report__disclaimer" style="margin-top: 6px;" data-testid="ai-disclaimer">STATISTICAL SIGNAL ONLY — NOT proof of AI authorship. Unreliable on short texts, non-native English, and heavily edited writing; never sole or definitive evidence.</p></section><p class="gds-jc__disclaimer" data-testid="language-note">Detected language: English — the calibrated thresholds apply. Non-native English writers are disproportionately over-flagged by AI detectors.</p><div class="gds-card  "><h3 class="gds-card__title">AI-associated signal</h3><div style="display: flex; gap: 16px; align-items: baseline; flex-wrap: wrap;"><span style="font-size: 40px; font-weight: 700;" data-testid="ai-proportion">42.0%</span><span style="color: var(--g-text-3); font-size: 13px; max-width: 560px;">of the analyzed text shows AI-associated signals. This is a deterministic proportion of flagged text; it is NOT the chance that this document was AI-written, and no such number exists in this report.</span></div><p class="gds-jc__disclaimer" style="margin-top: 8px;" data-testid="coverage-note">3 candidate passage(s) from the fast pre-pass; deep-verified 1; cleared 1 as document-baseline; 1 remain heuristic-only (analysis budget: 16 passages / 2000 tokens)</p></div><div class="gds-card  " data-testid="evidence-summary"><h3 class="gds-card__title">Evidence Summary</h3><p class="aic-ev__gate">Individual signals: not a verdict, and not combined into a score. A calibrated 0–100 score isn't shown: it requires evaluation Gaply hasn't completed yet. Each level below is the STRENGTH of the AI-associated signal.</p><div class="aic-ev__band aic-ev__band--factual" data-testid="evidence-group-factual"><div class="aic-ev__bandhead"><span class="aic-ev__bandlabel">VERIFIABLE (world-checkable)</span></div><div class="aic-ev__row" data-testid="evidence-row"><span class="aic-ev__level aic-ev__level--high">High</span><span><span class="aic-ev__signal">Citation verification</span>: <span class="aic-ev__detail">2 of 14 references could not be verified (2 not found; 0 DOI mismatch)</span></span></div></div><div class="aic-ev__band aic-ev__band--structural" data-testid="evidence-group-structural"><div class="aic-ev__bandhead"><span class="aic-ev__bandlabel">STRUCTURAL</span></div><div class="aic-ev__row" data-testid="evidence-row"><span class="aic-ev__level aic-ev__level--high">High</span><span><span class="aic-ev__signal">template phrasing</span>: <span class="aic-ev__detail">3.1 markers / 1000 words (≥2 distinct)</span></span></div><div class="aic-ev__row" data-testid="evidence-row"><span class="aic-ev__level aic-ev__level--muted">Unavailable</span><span><span class="aic-ev__signal">citation density</span>: <span class="aic-ev__detail">references present but in-text citations could not be attributed — density unreliable</span></span></div></div><div class="aic-ev__band aic-ev__band--stylometric" data-testid="evidence-group-stylometric"><div class="aic-ev__bandhead"><span class="aic-ev__bandlabel">STYLE-BASED</span><span class="aic-ev__caveat">(less reliable; can over-flag non-native English writing)</span></div><div class="aic-ev__row" data-testid="evidence-row"><span class="aic-ev__level aic-ev__level--moderate">Moderate</span><span><span class="aic-ev__signal">Language-model perplexity</span>: <span class="aic-ev__detail">below the human academic median</span><sup>¹</sup></span></div><div class="aic-ev__row" data-testid="evidence-row"><span class="aic-ev__level aic-ev__level--moderate">Moderate</span><span><span class="aic-ev__signal">sentence-length burstiness</span>: <span class="aic-ev__detail">CV 0.26 (human ≈ 0.43)</span></span></div><div class="aic-ev__row" data-testid="evidence-row"><span class="aic-ev__level aic-ev__level--high">High</span><span><span class="aic-ev__signal">Deep-verifier perplexity</span>: <span class="aic-ev__detail">compact 1.5B on-device verifier re-scored 2 flagged passage(s); 2 fell below the human academic perplexity norm (the human range overlaps AI — a soft, down-weighted signal)</span><sup>¹</sup></span></div></div><p class="aic-ev__footnote" data-testid="provisional-footnote">¹ preliminary: norms not yet held-out-evaluated</p></div><p style="font-size: 12px; color: var(--g-text-3); margin: 0px;" data-testid="aicheck-legend">Plain text: no AI-associated signal. <span class="gds-highlight" data-tier="assessed" style="cursor: default;">amber</span>: heuristic-only flag (preliminary). <span class="gds-highlight" data-tier="flagged" style="cursor: default;">red</span>: deep-verified (re-scored by the on-device deep model). All are signal levels, never verdicts. Click a highlight for its evidence.</p><div class="gds-manuscript" data-testid="aicheck-manuscript"><section class="gds-ms-section"><h3 class="gds-ms-section__heading">Introduction</h3><p class="gds-ms-section__body">Her grandmother’s schematics were scrawled across napkins. <button class="gds-highlight" data-tier="flagged" data-testid="aicheck-highlight-0" aria-current="false" title="click to see the evidence">The results show that the model can do the work well. The system is fast.</button> Nobody anticipated theatrical flair from a toaster. <button class="gds-highlight" data-tier="assessed" data-testid="aicheck-highlight-1" aria-current="false" title="click to see the evidence">The user can see the way to go now.</button> It wheezed absurdly.</p></section></div><div class="gds-card  " data-testid="per-passage-findings"><h3 class="gds-card__title">Per-passage findings</h3><p class="gds-jc__disclaimer" data-testid="findings-split">1 of 2 flagged passages were deep-verified by the on-device model; the remaining 1 carry heuristic-only flags and are preliminary.</p><div id="finding-0" class="gds-finding" data-testid="finding-0" aria-current="false"><p class="gds-finding__num">Passage 1</p><blockquote class="gds-finding__text">The results show that the model can do the work well. The system is fast.</blockquote><div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;"><span class="gds-badge gds-badge--flagged ">deep-verified signal</span><span class="gds-badge gds-badge--neutral ">strength: strong</span><span class="gds-mono" style="font-size: 12px; color: var(--g-text-3);">mean perplexity 4.5 · burstiness 0.3</span></div><p class="gds-jc__disclaimer" data-testid="finding-0-depth-note">Deep-verified: the full on-device model (7B) re-scored this passage, a stronger measurement than the fast pre-pass. Still a SIGNAL, not proof of AI authorship.</p><p class="gds-jc__disclaimer" data-testid="finding-0-uncertainty">AI-associated SIGNAL, not a determination of authorship. High false-positive rates.</p><p class="gds-jc__disclaimer" data-testid="finding-0-category-note">Paraphrase distinction unavailable — no supported local model currently distinguishes AI-generated from AI-paraphrased text reliably. The passage keeps its two-way AI-associated signal; no category was guessed.</p><table style="width: 100%; font-size: 12px; margin-top: 8px; border-collapse: collapse;" data-testid="finding-0-sentences"><thead><tr style="text-align: left; color: var(--g-text-3);"><th style="padding-right: 8px;">sentence</th><th>perplexity</th></tr></thead><tbody><tr><td style="padding-right: 8px;">The results show that the model can do the work well.</td><td class="gds-mono">4.2</td></tr><tr><td style="padding-right: 8px;">The system is fast.</td><td class="gds-mono">4.8</td></tr></tbody></table></div><div id="finding-1" class="gds-finding" data-testid="finding-1" aria-current="false"><p class="gds-finding__num">Passage 2</p><blockquote class="gds-finding__text">The user can see the way to go now.</blockquote><div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;"><span class="gds-badge gds-badge--assessed ">heuristic-only (preliminary)</span><span class="gds-badge gds-badge--neutral ">strength: weak</span><span class="gds-mono" style="font-size: 12px; color: var(--g-text-3);">mean perplexity 5.9 · burstiness 0.0</span></div><p class="gds-jc__disclaimer" data-testid="finding-1-depth-note">Heuristic-only: flagged by the fast pre-pass and NOT model-verified (analysis budget). A preliminary, lower-confidence signal — never treat as proof.</p><p class="gds-jc__disclaimer" data-testid="finding-1-uncertainty">AI-associated SIGNAL, not a determination of authorship. High false-positive rates.</p><p class="gds-jc__disclaimer" data-testid="finding-1-category-note">Not classified: only deep-verified passages are sent to the classification model. This heuristic-only flag remains a preliminary signal.</p><table style="width: 100%; font-size: 12px; margin-top: 8px; border-collapse: collapse;" data-testid="finding-1-sentences"><thead><tr style="text-align: left; color: var(--g-text-3);"><th style="padding-right: 8px;">sentence</th><th>perplexity</th></tr></thead><tbody><tr><td style="padding-right: 8px;">The user can see the way to go now.</td><td class="gds-mono">5.9</td></tr></tbody></table></div></div><section data-testid="paraphrase-unavailable" class="aic-callout aic-callout--muted"><h4 style="margin: 0px 0px 6px;"><span class="gds-badge gds-badge--neutral ">AI-generated vs AI-paraphrased</span></h4><p class="gds-jc__disclaimer" data-testid="classification-note">1 deep-verified passage(s); paraphrase distinction UNAVAILABLE — no supported local model distinguishes AI-generated from AI-paraphrased reliably, so passages carry the two-way signal (human-written vs AI-associated) and nothing was guessed</p><p class="gds-jc__disclaimer" data-testid="paraphrase-caution">Category is a RESEMBLANCE SIGNAL, not a determination. Distinguishing AI-paraphrased from AI-generated text is EVEN LESS reliable than AI detection itself.</p></section><p class="gds-mono" style="font-size: 11px; color: var(--g-text-3); margin: 0px;" data-testid="aicheck-models">fast: heuristic frequency proxy (fast pre-pass) · deep: candle-slm1-q3</p></div>"`;

exports[`AiCheckReport — observable-output equivalence pin > Spanish (language-downgrade) fixture renders the locked DOM 1`] = `"<div class="gds-report" data-testid="aicheck-report" style="display: grid; gap: 12px;"><section data-testid="ai-caution" class="aic-callout"><span class="gds-badge gds-badge--flagged ">signal, not proof</span><p class="gds-report__disclaimer" style="margin-top: 6px;" data-testid="ai-disclaimer">STATISTICAL SIGNAL ONLY — NOT proof of AI authorship. Unreliable on short texts, non-native English, and heavily edited writing; never sole or definitive evidence.</p></section><section data-testid="language-downgrade" class="aic-callout"><span class="gds-badge gds-badge--flagged ">non-English text: low confidence</span><p class="gds-jc__disclaimer" style="margin-top: 6px;">NON-ENGLISH (or unidentifiable) text detected. Every signal in this report is LOW-CONFIDENCE for this document and false positives are substantially more likely.</p></section><div class="gds-card  "><h3 class="gds-card__title">AI-associated signal</h3><div style="display: flex; gap: 16px; align-items: baseline; flex-wrap: wrap;"><span style="font-size: 40px; font-weight: 700;" data-testid="ai-proportion">42.0%</span><span style="color: var(--g-text-3); font-size: 13px; max-width: 560px;">of the analyzed text shows AI-associated signals. This is a deterministic proportion of flagged text; it is NOT the chance that this document was AI-written, and no such number exists in this report.</span></div><p class="gds-jc__disclaimer" style="margin-top: 8px;" data-testid="coverage-note">3 candidate passage(s) from the fast pre-pass; deep-verified 1; cleared 1 as document-baseline; 1 remain heuristic-only (analysis budget: 16 passages / 2000 tokens)</p></div><div class="gds-card  " data-testid="evidence-summary"><h3 class="gds-card__title">Evidence Summary</h3><p class="aic-ev__gate">Individual signals: not a verdict, and not combined into a score. A calibrated 0–100 score isn't shown: it r