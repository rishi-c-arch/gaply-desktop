# GAPLY Frontend Environment Configuration
# Copy this file to .env.local and fill in your actual values

# API Configuration
VITE_API_BASE_URL=https://gaply-backend-gaply.up.railway.app

# Payment Gateway Configuration
REACT_APP_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Development Configuration
REACT_APP_ENV=development

# Optional: Analytics and Monitoring
# REACT_APP_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
# REACT_APP_SENTRY_DSN=https://your-sentry-dsn

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace the placeholder values with your actual credentials
# 3. Never commit .env.local to version control
# 4. For production, set these variables in your hosting platform

# Getting your Razorpay Key ID:
# 1. Go to https://dashboard.razorpay.com/
# 2. Navigate to Settings > API Keys
# 3. Copy your Test/Live Key ID

# Supabase — auth + metadata ONLY (the manuscript never touches Supabase).
# Leave unset to run in full OFFLINE MODE (all free-offline features work).
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-from-supabase-dashboard
