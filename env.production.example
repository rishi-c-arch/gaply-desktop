# GAPLY Frontend - Production Environment Variables
# Copy this file to .env.production and update with your values

# Backend API Configuration
REACT_APP_API_BASE_URL=https://your-go-backend-domain.com

# Razorpay Configuration (Production Keys)
REACT_APP_RAZORPAY_KEY_ID=rzp_live_REMOVED
REACT_APP_RAZORPAY_KEY_SECRET=RAZORPAY_SECRET_REMOVED

# Supabase Configuration (Optional - if using Supabase client-side)
REACT_APP_SUPABASE_URL=your-supabase-url
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key

# Environment
REACT_APP_ENVIRONMENT=production

# Optional: Analytics and Monitoring
REACT_APP_GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
REACT_APP_SENTRY_DSN=YOUR_SENTRY_DSN

# Optional: Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_ERROR_TRACKING=true
REACT_APP_ENABLE_PERFORMANCE_MONITORING=true

# Optional: CDN Configuration
REACT_APP_CDN_URL=https://your-cdn-domain.com

# Optional: Social Login (if implementing)
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id
REACT_APP_GITHUB_CLIENT_ID=your-github-client-id
